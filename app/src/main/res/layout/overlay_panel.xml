<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/stateDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_state_dot" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="待机中"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minLines="2"
        android:text="@string/overlay_waiting"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/overlay_command_label"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etCommand"
        android:layout_width="268dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_command_input"
        android:gravity="top|start"
        android:hint="@string/overlay_command_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="3"
        android:minLines="2"
        android:padding="8dp"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#88FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/overlay_start"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCollapse"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/overlay_collapse"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnExit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/overlay_exit"
            android:textColor="#FF8A80"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
